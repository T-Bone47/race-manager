### Unity ###
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore Assets meta files
!/UnityProject/Assets/**/*.meta

# Autogenerated VS/Rider/MD/Consulo solution and project files (Unity regenerates these)
UnityProject/*.csproj
UnityProject/*.unityproj
UnityProject/*.sln
UnityProject/*.suo
UnityProject/*.tmp
UnityProject/*.user
UnityProject/*.userprefs
UnityProject/*.pidb
UnityProject/*.booproj
UnityProject/*.svd
UnityProject/*.pdb
UnityProject/*.mdb
UnityProject/*.opendb
UnityProject/*.VC.db

# Unity3D generated meta files that should be ignored when the asset itself is ignored
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packages (UPM lockfile IS tracked deliberately, so do not blanket-ignore Packages/)
UnityProject/[Pp]ackages/*
!UnityProject/[Pp]ackages/manifest.json
!UnityProject/[Pp]ackages/packages-lock.json

### Python ###
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.ipynb_checkpoints/
dist/
build/
.mypy_cache/
.ruff_cache/

### .NET / C# ###
bin/
obj/
*.user
*.suo
.vs/
*.dll
*.pdb

### General ###
.DS_Store
Thumbs.db
*.log
.idea/
*.swp
